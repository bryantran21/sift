# Copy to .env.local and fill in. Never commit the real file.

# App database (Supabase). Use the TRANSACTION pooler — port 6543. It's built for
# serverless (Vercel) and has no low session-client cap, so many function instances
# won't exhaust it. src/db/client.ts sets `prepare: false`, which this pooler requires.
DATABASE_URL=postgres://user:password@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# Migrations only. drizzle-kit (migrate/push/studio) needs a SESSION-mode connection —
# port 5432 (or a direct connection). The transaction pooler above doesn't support the
# session features migrations use. Falls back to DATABASE_URL if unset, so it's only
# needed where you actually run migrations (local dev) — not on Vercel or in ingest.
MIGRATION_DATABASE_URL=postgres://user:password@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Optional: LLM key for the Stage-2 classification fallback (Phase 9). Unused for now.
# ANTHROPIC_API_KEY=
